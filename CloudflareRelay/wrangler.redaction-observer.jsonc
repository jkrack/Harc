{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harc-remote-redaction-observer",
  "main": "src/redaction-observer.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "logpush": false,
  "tail_consumers": [],
  "streaming_tail_consumers": [],
  "workers_dev": true,
  "routes": [],
  "durable_objects": {
    "bindings": [
      {
        "name": "REDACTION_SUMMARY",
        "class_name": "RedactionSummary"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RedactionSummary"]
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
