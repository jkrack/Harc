{
  "name": "@harc/remote-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types:check && npm run typecheck && npm test && npm run deploy:dry",
    "deploy:dry": "WRANGLER_SEND_ERROR_REPORTS=false wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "WRANGLER_SEND_ERROR_REPORTS=false wrangler types src/worker-configuration.d.ts",
    "types:check": "WRANGLER_SEND_ERROR_REPORTS=false wrangler types src/worker-configuration.d.ts --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@types/node": "22.15.17",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
